; Teeokratie — data-driven Adventure Creator runtime in Godot 4.3
; Rooms + logic are imported from the original Unity project as JSON (see extractor/).

config_version=5

[application]

config/name="Teeokratie"
config/version="0.1.18"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/Game.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="hotspots"
